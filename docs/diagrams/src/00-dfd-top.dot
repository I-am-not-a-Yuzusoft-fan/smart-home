// 图 F-1  顶层数据流图（可行性研究 步骤 3「导出新系统的高层逻辑模型」）
// 顶层只有一个加工、没有数据存储；数据存储在需求阶段的第 1 层展开（05-dfd.dot）。
digraph DFD_TOP {
  graph [rankdir=LR, fontname="PingFang SC", nodesep=0.9, ranksep=1.5, splines=spline, bgcolor="white", pad="0.3"];
  node  [fontname="PingFang SC", fontsize=12, margin="0.14,0.08"];
  edge  [fontname="PingFang SC", fontsize=9, color="#444444", arrowsize=0.7, penwidth=1.0];

  // 外部实体
  node [shape=box, style="filled", fillcolor="#E8E8E8"];
  住户;
  环境传感器 [label="环境传感器\n（温湿度 / 光照 / 人体）"];
  设备执行器;

  // 顶层唯一加工
  系统 [shape=ellipse, style="filled", fillcolor="#FFFFFF", width=2.6, height=1.3,
        label="0\n智能家居管理系统"];

  { rank=same; 环境传感器; 住户; }
  { rank=same; 系统; }
  { rank=same; 设备执行器; }

  住户 -> 系统 [label="户型与物品信息\n控制意图\n场景定义与执行请求\n手动接管"];
  系统 -> 住户 [label="状态推送\n调节依据说明\n历史曲线", style=dashed];
  环境传感器 -> 系统 [label="环境读数"];
  系统 -> 设备执行器 [label="设备指令"];
  设备执行器 -> 系统 [label="回显值 / 执行结果", style=dashed];
}
