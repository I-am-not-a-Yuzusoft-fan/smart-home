@startuml
' 图 1  系统用例图
' 对应：需求规格说明书 v1.0 第 2.1 节（角色与权限）、第 3 章（功能需求）
skinparam defaultFontName "PingFang SC"
skinparam shadowing false
skinparam actorStyle hollow
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #333333
  ArrowColor #333333
}

actor "家庭成员" as Member
actor "家庭管理员" as Admin
actor "定时器" as Timer <<system>>
actor "环境传感器" as Sensor <<system>>

Member <|-- Admin

rectangle "智能家居系统" {

  package "必做 F1～F5" {
    usecase "UC-01\n登录系统" as UC01
    usecase "UC-05\n控制设备\n(F4)" as UC05
    usecase "UC-06\n编排场景\n(F5)" as UC06
    usecase "UC-07\n一键执行场景\n(F5)" as UC07
    usecase "UC-02\n管理物品与设备\n(F1)" as UC02
    usecase "UC-03\n维护类型模板\n(F2)" as UC03
    usecase "UC-04\n绘制平面图与布放\n(F3)" as UC04
  }

  package "提高 E1～E4" {
    usecase "UC-08\n环境自适应调控\n(E1)" as UC08
    usecase "UC-09\n下发清扫任务\n(E2)" as UC09
    usecase "UC-10\n自然语言控制\n(E3)" as UC10
    usecase "UC-11\n与智能管家对话\n(E4)" as UC11
  }

  usecase "UC-12\n查看只读大屏" as UC12
}

Member --> UC01
Member --> UC05
Member --> UC06
Member --> UC07
Member --> UC09
Member --> UC10
Member --> UC11
Member --> UC12

Admin --> UC02
Admin --> UC03
Admin --> UC04

Timer --> UC07 : 定时触发
Timer --> UC08 : 周期求值
Sensor --> UC08 : 数据上报

UC07 ..> UC05 : <<include>>
UC08 ..> UC05 : <<include>>
UC10 ..> UC05 : <<include>>
UC11 ..> UC05 : <<include>>



@enduml
