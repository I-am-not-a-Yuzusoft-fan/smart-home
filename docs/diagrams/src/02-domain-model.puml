@startuml
' 图 2  领域模型类图（概念层，与实现无关）
skinparam defaultFontName "PingFang SC"
skinparam shadowing false
skinparam classAttributeIconSize 0
hide circle
hide empty members

class 用户 {
  + 账号
  + 显示名
  + 角色 {管理员, 家庭成员}
}

class 房间 {
  + 名称
  + 用途 {客厅,卧室,厨房,卫生间,书房,走廊}
  + 多边形顶点
}

class 墙体 {
  + 起点坐标
  + 终点坐标
  + 厚度
}

class 开口 {
  + 类型 {门, 窗}
  + 沿墙位置
  + 宽度
  + 高度
}

class 物品 {
  + 名称
  + 类别
  + 坐标
  + 旋转角
}

class 家具
class 设备

class 类型模板 {
  + 名称
  + 类别
  + 默认尺寸
  + 图标
}

class 能力项 {
  + 名称
  + 数据类型
  + 取值范围
  + 单位
  + 是否可写
  + 默认值
}

class 能力状态 {
  + 当前值
  + 最近更新时间
}

class 感知读数 {
  + 类型 {温度,湿度,光照,人体存在}
  + 数值
  + 采集时间
}

class 状态历史 {
  + 值
  + 记录时间
  + 来源 {人工,场景,自动,设备}
}

class 场景 {
  + 名称
  + 守卫条件
}

class 场景动作 {
  + 动作类型
  + 参数
  + 延时
  + 顺序号
}

class 操作记录 {
  + 操作者
  + 时间
  + 结果 {成功,失败,超时}
}

用户 "1" -- "0..*" 操作记录 : 产生
房间 "1" -- "0..*" 物品 : 所属
房间 "1" -- "0..*" 墙体 : 围合
墙体 "1" -- "0..*" 开口 : 开有
物品 <|-- 家具
物品 <|-- 设备
物品 "0..*" -- "1" 类型模板 : 属于
类型模板 "1" -- "1..*" 能力项 : 定义
设备 "1" -- "0..*" 能力状态 : 持有
能力状态 "0..*" -- "1" 能力项 : 对应
设备 "1" -- "0..*" 感知读数 : 上报
设备 "1" -- "0..*" 状态历史 : 留下
场景 "1" -- "1..*" 场景动作 : 包含
场景动作 "0..*" --> "1" 设备 : 作用于
场景动作 ..> 能力项 : 指定

note right of 能力项
  能力项是【定义】，不属于任何一台设备；
  能力状态是【某台设备某个能力项的值】。
  F2「新增类型不改前端」靠的是这一对分离。
end note

note bottom of 状态历史
  只在「值变化」或「来源变化」时写入一行，
  不是定时采样。
end note

@enduml
